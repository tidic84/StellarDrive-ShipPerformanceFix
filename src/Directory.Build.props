<Project>

  <!-- Shared by every mod of the suite: game + MelonLoader references, nothing copied to the output. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <DebugType>none</DebugType>
    <NoWarn>CS0436;CS1701;CS1702</NoWarn>
    <OutputPath>$(MSBuildThisFileDirectory)..\bin\$(Configuration)\</OutputPath>

    <!-- Override on the command line: dotnet build -p:GamePath="D:\SteamLibrary\steamapps\common\StellarDrive Demo" -->
    <GamePath Condition="'$(GamePath)' == ''">C:\Program Files (x86)\Steam\steamapps\common\StellarDrive Demo</GamePath>
    <ManagedPath>$(GamePath)\StellarDrive_Data\Managed</ManagedPath>
    <MelonLoaderPath Condition="'$(MelonLoaderPath)' == ''">$(GamePath)\MelonLoader\net35</MelonLoaderPath>
    <ModsPath Condition="'$(ModsPath)' == ''">$(GamePath)\Mods</ModsPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="MelonLoader"><HintPath>$(MelonLoaderPath)\MelonLoader.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(MelonLoaderPath)\0Harmony.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <!-- Dev tooling shared by every mod (compiled only with DEV). -->
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)Shared\**\*.cs" Link="Shared\%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Every game and Unity assembly, except the BCL ones netstandard already provides. -->
  <ItemGroup>
    <GameAssembly Include="$(ManagedPath)\*.dll" Exclude="$(ManagedPath)\mscorlib.dll;$(ManagedPath)\netstandard.dll;$(ManagedPath)\System*.dll;$(ManagedPath)\Mono.*.dll;$(ManagedPath)\Microsoft.*.dll" />
    <Reference Include="@(GameAssembly)" Private="false" />
  </ItemGroup>

</Project>
